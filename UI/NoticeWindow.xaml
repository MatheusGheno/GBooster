<Window x:Class="GBooster.UI.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GBooster" Icon="pack://application:,,,/Assets/app.ico" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}" FontFamily="{StaticResource Font.Body}">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Antes de começar" FontFamily="{StaticResource Font.Display}" FontSize="20" FontWeight="Bold"
               Foreground="{DynamicResource Brush.TextPrimary}"/>
    <TextBlock Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="13" LineHeight="20"
               Foreground="{DynamicResource Brush.TextSecondary}"
               Text="Para a resolução esticada ocupar a tela toda (sem barras pretas), ative a escala “Tela inteira” nas configurações da sua placa de vídeo."/>
    <TextBlock Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="13" LineHeight="20"
               Foreground="{DynamicResource Brush.TextSecondary}"
               Text="A configuração de saturação só funciona em placas NVIDIA."/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="OK" Style="{StaticResource BtnPrimary}" Height="40" IsDefault="True" IsCancel="True" Click="Ok_Click"/>
    </StackPanel>
  </Grid>
</Window>
