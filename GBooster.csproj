<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- só para o ícone da bandeja (NotifyIcon) -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings> <!-- WPF + WinForms juntos geram nomes ambíguos com usings implícitos -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained> <!-- o publish (COMPILAR.bat / GitHub) liga o modo autocontido -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>GBooster</AssemblyName>
    <RootNamespace>GBooster</RootNamespace>
    <Version>0.1.0</Version>
    <!-- Leveza: menos threads, menos memória e abertura mais rápida. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Trava as versões exatas das dependências em packages.lock.json (item 1 do checklist). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Avisa sobre dependências com falha de segurança conhecida (item 2). -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Saturação NVIDIA (Digital Vibrance) via API pública da NVIDIA. Licença LGPL-3.0. -->
    <PackageReference Include="NvAPIWrapper.Net" Version="0.8.*" />
  </ItemGroup>

</Project>
